								<Code><![CDATA[Envio envio = (Envio) agent;

// Circuitos 1 a 3: el contenedor se estiba en el origen, con el portacontenedor
// esperando al pie (ADR-050).
if (envio.contenedor != null) {
    envio.contenedor.horaInicioCarga = time();

    envio.contenedor.estado =
        EstadoContenedor.CONSOLIDANDO;
}

registrarEtapaEnvio((Envio) agent, "cargarCamion", ((Envio) agent).tiempoCargaHoras);]]></Code>
