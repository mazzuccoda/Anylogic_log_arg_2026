					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Main modelo = (Main) getRootAgent();

return modelo.inventario.reservadoLote(idLote);]]></Body>
				</Function>
