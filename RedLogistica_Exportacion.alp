			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1784760643917</Id>
					<Name><![CDATA[calcularCantidadContenedores]]></Name>
					<X>570</X><Y>650</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (capacidadContenedorTon <= 0) {
    error(
        "Capacidad de contenedor inválida para pedido: "
        + this
    );
    return 0;
}

return (int) Math.ceil(
    toneladasSolicitadas / capacidadContenedorTon
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792400000301</Id>
					<Name><![CDATA[toneladasAsignadasAcumuladas]]></Name>
					<X>560</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Todo lo que el pedido llego a comprometer, en todos sus origenes (ADR-055). Las
// asignaciones canceladas no cuentan: lo suyo volvio a estar por asignar.
double total = 0;

for (AsignacionPedido asignacion : asignaciones) {

    if (!asignacion.cancelada) {
        total += asignacion.toneladasAsignadas;
    }
}

return total;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792400000303</Id>
					<Name><![CDATA[toneladasReservadasActivas]]></Name>
					<X>560</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Reserva viva sobre las capas: lo comprometido que todavia no salio fisicamente.
double total = 0;

for (AsignacionPedido asignacion : asignaciones) {

    if (!asignacion.cancelada) {
        total += asignacion.toneladasReservadasActivas;
    }
}

return total;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792400000305</Id>
					<Name><![CDATA[toneladasContenerizadas]]></Name>
					<X>560</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double total = 0;

for (AsignacionPedido asignacion : asignaciones) {

    if (!asignacion.cancelada) {
        total += asignacion.toneladasContenerizadas;
    }
}

return total;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792400000307</Id>
					<Name><![CDATA[toneladasEnProceso]]></Name>
					<X>560</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Despachado y no entregado: ya consumio la reserva y todavia no llego. Es la
// definicion que hace cerrar la identidad del pedido (C-01).
double total = 0;

for (AsignacionPedido asignacion : asignaciones) {

    if (!asignacion.cancelada) {
        total += asignacion.toneladasEnProceso();
    }
}

return total;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792400000309</Id>
					<Name><![CDATA[toneladasPendientesAsignar]]></Name>
					<X>560</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Lo que falta comprometer. Es el saldo con el que trabaja el evaluador: un pedido
// parcialmente reservado sigue siendo demanda por la diferencia (ADR-055).
return max(
    0,
    toneladasSolicitadas - toneladasAsignadasAcumuladas()
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792400000311</Id>
					<Name><![CDATA[toneladasPendientesEntregar]]></Name>
					<X>560</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return max(0, toneladasSolicitadas - toneladasEntregadas);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1792400000313</Id>
					<Name><![CDATA[estaCompleto]]></Name>
					<X>560</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return toneladasEntregadas >= toneladasSolicitadas - 0.0001;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1792400000315</Id>
					<Name><![CDATA[cantidadOrigenes]]></Name>
					<X>560</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Cuantos sitios distintos sirvieron al pedido: uno es el caso de siempre y mas de
// uno es lo que este MOD hace posible.
java.util.List<String> sitios = new java.util.ArrayList<String>();

for (AsignacionPedido asignacion : asignaciones) {

    if (
        !asignacion.cancelada
        && !sitios.contains(asignacion.idSitioOrigen)
    ) {
        sitios.add(asignacion.idSitioOrigen);
    }
}

return sitios.size();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[java.util.List<AsignacionPedido>]]></ReturnType>
					<Id>1792400000317</Id>
					<Name><![CDATA[asignacionesActivas]]></Name>
					<X>560</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[java.util.List<AsignacionPedido> activas =
    new java.util.ArrayList<AsignacionPedido>();

for (AsignacionPedido asignacion : asignaciones) {

    if (asignacion.activa()) {
        activas.add(asignacion);
    }
}

return activas;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[AsignacionPedido]]></ReturnType>
					<Id>1792400000319</Id>
					<Name><![CDATA[buscarAsignacion]]></Name>
					<X>560</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[idAsignacion]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[for (AsignacionPedido asignacion : asignaciones) {

    if (asignacion.idAsignacion.equals(idAsignacion)) {
        return asignacion;
    }
}

return null;]]></Body>
				</Function>
