						<Parameter>
							<Name><![CDATA[onAtExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Envio envio = (Envio) agent;

// Con consolidacion en deposito el contenedor llega estibado: el bloque es de
// paso, con tiempo cero, y el servicio ya se devengo en el deposito.
if (!estibaEnDeposito(envio.pedido)) {

    envio.terminalDestino
        .toneladasConsolidadas +=
            envio.toneladas;

    envio.terminalDestino
        .costoConsolidacionAcumulado +=
            envio.costoConsolidacionReal;
}

envio.estado =
    EstadoEnvio.RETORNANDO;]]></Code>
							</Value>
