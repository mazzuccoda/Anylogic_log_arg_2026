						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// Consolidar en la terminal lo cobra la terminal, con la unidad de su tarifa
// (ADR-051). El agente ya no guarda una copia de la tarifa por producto.
Main modelo = (Main) getRootAgent();

return modelo.datos.importeConsolidacion(
    modelo.diaCampania(),
    idUbicacion,
    producto,
    toneladas,
    contenedores
);]]></Body>
				</Function>
