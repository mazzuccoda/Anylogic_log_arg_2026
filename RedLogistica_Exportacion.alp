				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1784396176929</Id>
					<Name><![CDATA[reservarProducto]]></Name>
					<X>1260</X><Y>580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[producto]]></Name>
						<Type><![CDATA[TipoProducto]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[toneladas]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (!puedeReservar(producto, toneladas)) {
    traceln(
        nombreDeposito
        + " no puede reservar "
        + toneladas
        + " tn de "
        + producto
        + " | disponible="
        + getDisponible(producto)
    );

    return false;
}

switch (producto) {

    case JUGO:
        reservadoJugo += toneladas;
        break;

    case CASCARA:
        reservadoCascara += toneladas;
        break;

    case ACEITE:
        reservadoAceite += toneladas;
        break;

    default:
        return false;
}

traceln(
    nombreDeposito
    + " reservó "
    + toneladas
    + " tn de "
    + producto
    + " | reservado total="
    + getReservado(producto)
);

return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1784396261216</Id>
					<Name><![CDATA[liberarReserva]]></Name>
					<X>1260</X><Y>620</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[producto]]></Name>
						<Type><![CDATA[TipoProducto]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[toneladas]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (toneladas <= 0) {
    return false;
}

switch (producto) {
    case JUGO:
        if (reservadoJugo < toneladas) {
            return false;
        }
        reservadoJugo -= toneladas;
        return true;

    case CASCARA:
        if (reservadoCascara < toneladas) {
            return false;
        }
        reservadoCascara -= toneladas;
        return true;

    case ACEITE:
        if (reservadoAceite < toneladas) {
            return false;
        }
        reservadoAceite -= toneladas;
        return true;

    default:
        return false;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1784396306291</Id>
					<Name><![CDATA[despacharReservado]]></Name>
					<X>1260</X><Y>670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[producto]]></Name>
						<Type><![CDATA[TipoProducto]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[toneladas]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (toneladas <= 0) {
    return false;
}

if (getReservado(producto) < toneladas) {
    return false;
}

if (getStock(producto) < toneladas) {
    return false;
}

if (!retirarProducto(producto, toneladas)) {
    return false;
}

if (!liberarReserva(producto, toneladas)) {
    recibirProducto(producto, toneladas);
    return false;
}

return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1784593269983</Id>
					<Name><![CDATA[getDistanciaTerminal]]></Name>
					<X>670</X><Y>560</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[terminal]]></Name>
						<Type><![CDATA[Terminal]]></Type>
					</Parameter>
					<Body><![CDATA[if (terminal == null) {
    return Double.POSITIVE_INFINITY;
}

Main modelo = (Main) getRootAgent();

return modelo.datos.distanciaKm(
    idUbicacion,
    terminal.idUbicacion
);]]></Body>
				</Function>
			</Functions>
