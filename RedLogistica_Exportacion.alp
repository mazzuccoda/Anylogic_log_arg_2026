			<StartupCode><![CDATA[Main m = (Main) get_Main();

if (producto != null) {
    tipoContenedor = m.obtenerTipoContenedor(producto);
    capacidadContenedorTon =
        m.obtenerCapacidadContenedorTon(tipoContenedor);
}]]></StartupCode>
