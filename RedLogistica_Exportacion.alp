							<Value Class="CodeValue">
								<Code><![CDATA[Envio envio = (Envio) agent;

// El portacontenedor no aparece en el origen: sale vacio de la terminal y hace el
// tramo hasta planta o deposito antes de poder estibar (ADR-050).
if (envio.contenedor != null) {
    envio.contenedor.estado =
        EstadoContenedor.EN_TRANSITO_VACIO;
}]]></Code>
