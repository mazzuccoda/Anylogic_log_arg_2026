								<Code><![CDATA[Envio envio = (Envio) agent;

// Circuito 4: el producto se carga a granel en el origen y el contenedor todavia
// no existe fisicamente; se arma en la terminal.
envio.estado = EstadoEnvio.CARGANDO;

if (envio.contenedor != null) {
    envio.contenedor.horaInicioCarga = time();
}]]></Code>
