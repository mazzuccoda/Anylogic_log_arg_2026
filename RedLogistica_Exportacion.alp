			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1784376540993</Id>
					<Name><![CDATA[getStock]]></Name>
					<X>200</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[producto]]></Name>
						<Type><![CDATA[TipoProducto]]></Type>
					</Parameter>
					<Body><![CDATA[// El stock del deposito se deriva de sus capas (ADR-023).
Main modelo = (Main) getRootAgent();

return modelo.inventario.stock(idUbicacion, producto);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1784376626749</Id>
					<Name><![CDATA[getCapacidad]]></Name>
					<X>370</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[producto]]></Name>
						<Type><![CDATA[TipoProducto]]></Type>
					</Parameter>
					<Body><![CDATA[switch (producto) {

    case JUGO:
        return capacidadJugo;

    case CASCARA:
        return capacidadCascara;

    case ACEITE:
        return capacidadAceite;

    default:
        return 0;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1784376684133</Id>
					<Name><![CDATA[getEspacioDisponible]]></Name>
					<X>200</X><Y>640</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[producto]]></Name>
						<Type><![CDATA[TipoProducto]]></Type>
					</Parameter>
					<Body><![CDATA[return max(
    0,
    getCapacidad(producto) - getStock(producto)
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1784376757466</Id>
					<Name><![CDATA[getTarifaAlmacenamiento]]></Name>
					<X>210</X><Y>690</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[producto]]></Name>
						<Type><![CDATA[TipoProducto]]></Type>
					</Parameter>
					<Body><![CDATA[switch (producto) {

    case JUGO:
        return costoJugoTnDia;

    case CASCARA:
        return costoCascaraTnDia;

    case ACEITE:
        return costoAceiteTnDia;

    default:
        return 0;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1784376814171</Id>
					<Name><![CDATA[puedeRecibir]]></Name>
					<X>200</X><Y>570</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[producto]]></Name>
						<Type><![CDATA[TipoProducto]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[toneladas]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (!habilitado) {
    return false;
}

if (toneladas <= 0) {
    return false;
}

return getEspacioDisponible(producto) >= toneladas;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1784395664486</Id>
					<Name><![CDATA[getImporteFletePuerto]]></Name>
					<X>460</X><Y>700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[terminal]]></Name>
						<Type><![CDATA[Terminal]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[producto]]></Name>
						<Type><![CDATA[TipoProducto]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[toneladas]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (terminal == null) {
    return Double.POSITIVE_INFINITY;
}

Main modelo = (Main) getRootAgent();

return modelo.datos.importeFlete(
    modelo.diaCampania(),
    idUbicacion,
    terminal.idUbicacion,
    producto,
    toneladas,
    modelo.viajesNecesariosCamion(toneladas)
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1784395920526</Id>
					<Name><![CDATA[getReservado]]></Name>
					<X>1080</X><Y>540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[producto]]></Name>
						<Type><![CDATA[TipoProducto]]></Type>
					</Parameter>
					<Body><![CDATA[// Lo reservado es la suma de las reservas anotadas en las capas (ADR-024).
Main modelo = (Main) getRootAgent();

return modelo.inventario.reservado(idUbicacion, producto);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1784396041840</Id>
					<Name><![CDATA[getDisponible]]></Name>
					<X>1080</X><Y>580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[producto]]></Name>
						<Type><![CDATA[TipoProducto]]></Type>
					</Parameter>
					<Body><![CDATA[return max(
    0,
    getStock(producto) - getReservado(producto)
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1784396104428</Id>
					<Name><![CDATA[puedeReservar]]></Name>
					<X>1260</X><Y>540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[producto]]></Name>
						<Type><![CDATA[TipoProducto]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[toneladas]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (!habilitado) {
    return false;
}

if (toneladas <= 0) {
    return false;
}

return getDisponible(producto) >= toneladas;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1784593269983</Id>
					<Name><![CDATA[getDistanciaTerminal]]></Name>
					<X>670</X><Y>560</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[terminal]]></Name>
						<Type><![CDATA[Terminal]]></Type>
					</Parameter>
					<Body><![CDATA[if (terminal == null) {
    return Double.POSITIVE_INFINITY;
}

Main modelo = (Main) getRootAgent();

return modelo.datos.distanciaKm(
    idUbicacion,
    terminal.idUbicacion
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1785000110</Id>
					<Name><![CDATA[getImporteConsolidacion]]></Name>
					<X>130</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[producto]]></Name>
						<Type><![CDATA[TipoProducto]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[toneladas]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[contenedores]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// La tarifa de estiba vive en la tabla y no en el agente (ADR-036), y con ella su
// unidad: por tonelada o por contenedor completo (ADR-051).
Main modelo = (Main) getRootAgent();

return modelo.datos.importeConsolidacion(
    modelo.diaCampania(),
    idUbicacion,
    producto,
    toneladas,
    contenedores
);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1785010110</Id>
					<Name><![CDATA[getImporteCrossDock]]></Name>
					<X>130</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[producto]]></Name>
						<Type><![CDATA[TipoProducto]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[toneladas]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[contenedores]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[// El cross dock es otro servicio que la estiba desde stock: tiene su propia columna
// en TarifaSitio (ADR-041).
Main modelo = (Main) getRootAgent();

return modelo.datos.importeCrossDock(
    modelo.diaCampania(),
    idUbicacion,
    producto,
    toneladas,
    contenedores
);]]></Body>
				</Function>
