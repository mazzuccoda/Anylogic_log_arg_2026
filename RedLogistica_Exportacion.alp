		f.append(AuditoriaRed.num(saldoPedidoAntes)).append(',');
		f.append(AuditoriaRed.num(saldoPedidoDespues)).append(',');
		f.append(AuditoriaRed.si(esMasBarataNoFactible));

		return f.toString();
	}
}]]></Text>
